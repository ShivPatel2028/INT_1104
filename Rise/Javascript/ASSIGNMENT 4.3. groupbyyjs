function groupBy(array, property) {
    return array.reduce((acc, obj) => {
        const key = obj[property];
        if (!acc[key]) {
            acc[key] = [];
        }
        acc[key].push(obj);
        return acc;
    }, {});
}

// Example usage:
const data = [
    { name: 'Rahul', age: 25 },
    { name: 'shetal', age: 30 },
    { name: 'Gaurang', age: 25 }
];

const groupedByAge = groupBy(data, 'age');
console.log(groupedByAge);